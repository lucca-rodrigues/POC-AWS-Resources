'use strict';

// {{description}}
// Tipo: {{type}}

const STAGE = process.env.STAGE ?? 'dev';

function log(message, data = {}) {
  console.log(JSON.stringify({ message, data: { ...data, stage: STAGE } }));
}

{{#if (eq type 'http')}}
// HTTP: rota de API — responde com base no path/method recebidos.
/**
 * Responde requisicoes HTTP com base no path e method recebidos.
 * @param {object} event - Evento recebido do API Gateway.
 * @returns {Promise<object>} Resposta HTTP no formato proxy (statusCode, headers, body).
 */
exports.handler = async (event) => {
  try {
    const path = event.rawPath ?? event.path ?? '/';
    const method = event.requestContext?.http?.method ?? event.httpMethod ?? 'GET';

    log('{{name}}.requisicao', { path, method });

    return {
      statusCode: 200,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: 'ok', path, method, stage: STAGE }),
    };
  } catch (error) {
    log('{{name}}.erro', { erro: error.message });
    return {
      statusCode: 500,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ erro: 'erro interno' }),
    };
  }
};
{{/if}}

{{#if (eq type 'integracao')}}
// Integracao com terceiros: chama uma API externa via fetch (com timeout).
// Recebe { url } via API Gateway e retorna a resposta da API externa.
const TIMEOUT_MS = 5000;

/**
 * Chama uma API externa via fetch e retorna a resposta.
 * @param {object} event - Evento recebido do API Gateway com { url } no body.
 * @returns {Promise<object>} Resposta HTTP no formato proxy com o resultado da integracao.
 */
exports.handler = async (event) => {
  try {
    const body = JSON.parse(event.body ?? '{}');
    const { url } = body;

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), TIMEOUT_MS);

    try {
      const response = await fetch(url, { method: 'GET', signal: controller.signal });
      const data = await response.json();

      log('{{name}}.integracao', { url, status: response.status });

      return {
        statusCode: 200,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: response.status, data }),
      };
    } finally {
      clearTimeout(timeout);
    }
  } catch (error) {
    log('{{name}}.erro', { erro: error.message });
    return {
      statusCode: 502,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ erro: 'falha na integracao' }),
    };
  }
};
{{/if}}

{{#if (eq type 'crud')}}
// CRUD com TypeORM (padrao crud-node): cria um registro no Postgres.
// Recebe { nome } via API Gateway e retorna o item criado (201).
const { DataSource } = require('typeorm');
const { SecretsManagerClient, GetSecretValueCommand } = require('@aws-sdk/client-secrets-manager');
const { Item } = require('./entity');

const SECRET_NAME = process.env.SECRET_NAME;

const secretsClient = new SecretsManagerClient({});
let configCache = null;
let dataSource = null;

// Converte a connection string Npgsql (.NET) para o formato URI do node-postgres.
function toPgConnectionString(npgsql) {
  const parts = Object.fromEntries(
    npgsql.split(';').map((part) => part.trim().split('='))
  );
  const host = parts.Host ?? parts.host;
  const port = parts.Port ?? parts.port ?? '5432';
  const database = parts.Database ?? parts.database;
  const user = parts.Username ?? parts.username;
  const password = parts.Password ?? parts.password;
  return `postgres://${encodeURIComponent(user)}:${encodeURIComponent(password)}@${host}:${port}/${database}`;
}

async function getConfig() {
  if (configCache) return configCache;
  const response = await secretsClient.send(
    new GetSecretValueCommand({ SecretId: SECRET_NAME })
  );
  configCache = JSON.parse(response.SecretString);
  return configCache;
}

async function getDataSource() {
  if (dataSource?.isInitialized) return dataSource;
  const config = await getConfig();
  dataSource = new DataSource({
    type: 'postgres',
    url: toPgConnectionString(config.Database.ConnectionString),
    entities: [Item],
    synchronize: true, // dev: cria a tabela automaticamente (em prod: migrations)
  });
  await dataSource.initialize();
  return dataSource;
}

/**
 * Cria um registro no Postgres usando TypeORM.
 * @param {object} event - Evento recebido do API Gateway com { nome } no body.
 * @returns {Promise<object>} Resposta HTTP no formato proxy com o item criado.
 */
exports.handler = async (event) => {
  try {
    const body = JSON.parse(event.body ?? '{}');
    const { nome } = body;

    const ds = await getDataSource();
    const repository = ds.getRepository('Item');
    const item = await repository.save({ nome });

    log('{{name}}.item.criado', { id: item.id, nome: item.nome });

    return {
      statusCode: 201,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ item }),
    };
  } catch (error) {
    log('{{name}}.erro', { erro: error.message });
    return {
      statusCode: 500,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ erro: 'erro interno' }),
    };
  }
};
{{/if}}
