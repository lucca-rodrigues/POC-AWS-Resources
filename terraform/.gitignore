# Diretorios .terraform locais (providers baixados, cache)
**/.terraform/*

# Arquivos de state: contem segredos e sao especificos de cada ambiente.
# NAO versionar. Em dev o state e descartavel (basta reaplicar).
*.tfstate
*.tfstate.*

# Logs de crash
crash.log
crash.*.log

# Arquivos de variaveis podem conter segredos (senhas, tokens)
*.tfvars
*.tfvars.json

# Arquivos de override (usados para ajustes locais)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Config de CLI
.terraformrc
terraform.rc

# O lock file DEVE ser versionado (trava a versao dos providers) -> excecao
!.terraform.lock.hcl
